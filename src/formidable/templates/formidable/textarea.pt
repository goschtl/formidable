<div class="${classes(theme.wrapper)}" data-conditions="${conditions}">
  <label class="${classes(theme.label)}" for="field-${name}">${title}</label>
  <textarea class="${css}" id="field-${name}" name="${name}" placeholder="${placeholder}" required="${required}">${value}</textarea>
  ${render_partial('formidable/error.pt', error=error, theme=theme)}
  ${render_partial('formidable/description.pt', description=description, theme=theme)}
</div>
