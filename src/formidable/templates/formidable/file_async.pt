<div class="${classes(theme.wrapper)}" data-conditions="${conditions}" tal:attributes="wrapper_attrs">
  <label class="${classes(theme.label)}" for="field-${name}">${title}</label>
  <input accept="${accept}" data-upload-files="${upload_files}" data-upload-options="${upload_options}" data-upload-url="${upload_url}" id="field-${name}" multiple="${multiple}" name="${name}" required="${required}" type="file" tal:attributes="control_attrs">
  ${render_partial('formidable/error.pt', error=error, theme=theme)}
  ${render_partial('formidable/description.pt', description=description, theme=theme)}
  ${render_partial('formidable/help.pt', help=help, theme=theme)}
</div>
