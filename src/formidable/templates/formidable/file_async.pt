<div aria-describedby="${described_by}" aria-labelledby="field-${name}-label" class="${classes(theme.wrapper)}" data-conditions="${conditions}" role="group" tal:attributes="wrapper_attrs">
  <label class="${classes(theme.label)}" for="field-${name}" id="field-${name}-label">${title}</label>
  <input accept="${accept}" data-upload-files="${upload_files}" data-upload-options="${upload_options}" data-upload-url="${upload_url}" id="field-${name}" multiple="${multiple}" name="${name}" required="${required}" type="file" tal:attributes="control_attrs">
  ${render_partial('formidable/error.pt', error=error, name=name, theme=theme)}
  ${render_partial('formidable/description.pt', description=description, name=name, theme=theme)}
  ${render_partial('formidable/help.pt', help=help, name=name, theme=theme)}
</div>
