<fieldset aria-describedby="${described_by}" class="${classes('field-radiogroup', theme.fieldset)}" data-conditions="${conditions}" id="field-${name}" tal:attributes="wrapper_attrs">
  <legend class="${classes(theme.legend)}">${title}</legend>
  <div tal:repeat="option options" class="field-radio-option">
    <input aria-invalid="${invalid}" checked="${option.selected}" class="${css}" id="field-${name}-${repeat.option.index}" name="${name}" required="${required}" type="radio" value="${option.value}" tal:attributes="control_attrs">
    <label for="field-${name}-${repeat.option.index}">${option.title}</label>
  </div>
  ${render_partial('formidable/error.pt', error=error, name=name, theme=theme)}
  ${render_partial('formidable/description.pt', description=description, name=name, theme=theme)}
  ${render_partial('formidable/help.pt', help=help, name=name, theme=theme)}
</fieldset>
