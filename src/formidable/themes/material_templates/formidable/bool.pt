<p data-conditions="${conditions}">
  <label>
    <input checked="${checked}" class="${css}" id="field-${name}" name="${name}" type="checkbox" value="${value}">
    <span>${title}</span>
  </label>
  ${render_partial('formidable/error.pt', error=error, theme=theme)}
  ${render_partial('formidable/description.pt', description=description, theme=theme)}
</p>
