<div class="input-field" data-conditions="${conditions}">
  <input class="${css}" id="field-${name}" name="${name}" placeholder="${placeholder}" required="${required}" step="${step}" type="${input_type}" value="${value}">
  <label class="${'active' if value is not None else None}" for="field-${name}">${title}</label>
  ${render_partial('formidable/error.pt', error=error, theme=theme)}
  ${render_partial('formidable/description.pt', description=description, theme=theme)}
</div>
