<div class="input-field" data-conditions="${conditions}" tal:attributes="wrapper_attrs">
  <input class="${css}" id="field-${name}" name="${name}" placeholder="${placeholder}" required="${required}" step="${step}" type="${input_type}" value="${value}" tal:attributes="control_attrs">
  <label class="${'active' if value is not None else None}" for="field-${name}">${title}</label>
  <span tal:condition="unit" class="${classes('field-unit', theme.unit)}">${unit}</span>
  ${render_partial('formidable/error.pt', error=error, theme=theme)}
  ${render_partial('formidable/description.pt', description=description, theme=theme)}
  ${render_partial('formidable/help.pt', help=help, theme=theme)}
</div>
